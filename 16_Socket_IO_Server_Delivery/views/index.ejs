<!DOCTYPE html>

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Socket.IO Server Delivery Lab</title>
        <style>
            body {
                font-family: Arial, sans-serif;
                max-width: 900px;
                margin: 40px auto;
                padding: 0 20px;
            }

            h1 {
                margin-bottom: 5px;
            }

            .subtitle {
                color: #666;
                margin-top: 0;
            }

            .info {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 15px;
                margin: 25px 0;
            }

            .card {
                border: 1px solid #ddd;
                border-radius: 8px;
                padding: 15px;
            }

            .card h3 {
                margin-top: 0;
                font-size: 14px;
                color: #666;
            }

            .card p {
                margin-bottom: 0;
                font-size: 18px;
                font-weight: bold;
            }

            .connection {
                padding: 12px;
                border-radius: 6px;
                background: #eee;
                margin-bottom: 25px;
            }

            .method {
                border: 1px solid #ddd;
                border-radius: 8px;
                padding: 20px;
                margin-bottom: 25px;
            }

            .method h2 {
                margin-top: 0;
            }

            .method p {
                color: #555;
            }

            .input-area {
                display: flex;
                gap: 10px;
            }

            input {
                flex: 1;
                padding: 10px;
                font-size: 16px;
            }

            button {
                padding: 10px 18px;
                cursor: pointer;
            }

            ul {
                padding-left: 20px;
            }

            li {
                margin-bottom: 8px;
            }

            .delivery-log {
                background: #f5f5f5;
                border-radius: 6px;
                padding: 15px;
                min-height: 50px;
            }

            .log-entry {
                margin-bottom: 8px;
                font-family: monospace;
            }
        </style>
    </head>
    <body>
        <h1>Socket.IO Server Delivery Lab</h1>
        <p class="subtitle">
            Learning how a server delivers state and missed events to clients.
        </p>
        <!-- Connection information -->
        <div id="connectionStatus" class="connection">
            Connecting to server...
        </div>
        <!-- Client state information -->
        <div class="info">
            <div class="card">
                <h3>Socket ID</h3>
                <p id="socketId">-</p>
            </div>
            <div class="card">
                <h3>Last Received ID</h3>
                <p id="lastReceivedId">0</p>
            </div>
            <div class="card">
                <h3>Messages on Client</h3>
                <p id="messageCount">0</p>
            </div>
        </div>
        <!-- Create messages -->
        <div class="method">
            <h2>Create Message</h2>
            <p>
                Create a message on the server. All currently connected clients
                will receive it.
            </p>
            <div class="input-area">
                <input
                    id="messageInput"
                    type="text"
                    placeholder="Enter a message..."
                />
                <button id="sendButton">Send Message</button>
            </div>
        </div>
        <!-- Delivery information -->
        <div class="method">
            <h2>Server Delivery</h2>
            <p>The client uses two different strategies when connecting:</p>
            <ul>
                <li>
                    <strong>Full State:</strong>
                    receive all messages currently stored on the server.
                </li>
                <li>
                    <strong>Missing Events:</strong>
                    receive only messages after the last received ID.
                </li>
            </ul>
            <div id="deliveryLog" class="delivery-log">No delivery yet.</div>
        </div>
        <!-- Messages -->
        <div class="method">
            <h2>Messages Received</h2>
            <ul id="messages"></ul>
        </div>
        <script src="/socket.io/socket.io.js"></script>
        <script src="/js/index.js"></script>
    </body>
</html>

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <title>Database Upload</title>
    </head>
    <body>
        <h1>MongoDB GridFS Upload</h1>
        <p>This file will NOT be saved inside the local uploads/ directory.</p>
        <p>It will be stored inside MongoDB using GridFS.</p>
        <form
            method="POST"
            action="/database-upload"
            enctype="multipart/form-data"
        >
            <input type="file" name="file" required />
            <br />
            <br />
            <button type="submit">Store in MongoDB</button>
        </form>
        <br />
        <a href="/tasks"> Back to Tasks </a>
    </body>
</html>
